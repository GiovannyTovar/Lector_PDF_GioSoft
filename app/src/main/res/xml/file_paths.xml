<?xml version="1.0" encoding="utf-8"?>
<paths>
    <!-- Solo carpetas privadas de la app. NO se expone el almacenamiento
         compartido: los archivos del usuario se leen por SAF, no por ruta. -->

    <!-- getExternalFilesDir(): copias heredadas y PDFs generados por el escaner -->
    <external-files-path name="external_files" path="." />

    <!-- getCacheDir(): copias temporales de PDFs abiertos por intent no persistible -->
    <cache-path name="cache" path="." />

    <!-- getExternalCacheDir() -->
    <external-cache-path name="external_cache" path="." />
</paths>
