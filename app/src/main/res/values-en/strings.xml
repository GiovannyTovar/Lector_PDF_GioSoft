    <string name="about_title">PDF GioSoft</string>
    <string name="about_tagline">Your documents, with no ads and no fuss.</string>
    <string name="about_version">Version %1$s</string>
    <string name="about_developed_by">Giovanny Tovar</string>
    <string name="about_developer_label">Development</string>
    <string name="about_why_title">Why it exists</string>
    <string name="about_why_text">Almost every PDF reader fills the screen with ads or asks for permissions it doesn’t need. This app was born to offer a simple alternative to friends, family and neighbors: open a document, read it, and get on with your day.</string>
    <string name="about_what_title">What it does</string>
    <string name="about_what_text">It opens your original files without duplicating them, organizes them by category, scans documents with the camera, prints and shares. Nothing more, nothing less.</string>
    <string name="about_thanks">Thanks for using it.</string>
    <string name="about_close">Close</string>

    <!-- Privacidad -->
    <string name="about_privacy_title">Privacy</string>
    <string name="privacy_tagline">Everything happens inside your phone.</string>
    <string name="privacy_point_permissions_title">No dangerous permissions</string>
    <string name="privacy_point_permissions_text">The app doesn’t ask for access to your storage or your camera. You open each file with the system picker, which grants access one file at a time.</string>
    <string name="privacy_point_network_title">No connection to servers</string>
    <string name="privacy_point_network_text">Your documents are not sent anywhere. There are no accounts, no analytics, no ads and no tracking.</string>
    <string name="privacy_point_copies_title">No copies behind your back</string>
    <string name="privacy_point_copies_text">The original file is the one being read. The only copy made is of documents shared with you through WhatsApp or email, whose access expires, and it is saved in Documents/My PDFs.</string>
    <string name="privacy_point_delete_title">Nothing is deleted on its own</string>
    <string name="privacy_point_delete_text">Removing a document from the list never deletes the file. It is only deleted from your phone if you ask for it and confirm.</string>
    <string name="privacy_point_lock_title">Fingerprint protection</string>
    <string name="privacy_point_lock_text">It protects the document inside this app and on this phone: the file is not encrypted. If you share it or open it with another app, it will open without asking for anything. For the protection to travel with the file, give it a password.</string>
    <string name="privacy_point_isolated_title">Isolated reading</string>
    <string name="privacy_point_isolated_text">PDFs are processed in a space separate from the rest of the app, so a damaged file can’t affect it.</string>

