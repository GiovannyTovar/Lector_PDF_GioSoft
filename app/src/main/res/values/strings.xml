    <string name="about_title">Lector PDF GioSoft</string>
    <string name="about_tagline">Tus documentos, sin publicidad y sin complicaciones.</string>
    <string name="about_version">Versión %1$s</string>
    <string name="about_developed_by">Giovanny Tovar</string>
    <string name="about_developer_label">Desarrollo</string>
    <string name="about_why_title">Por qué existe</string>
    <string name="about_why_text">Casi todos los lectores de PDF llenan la pantalla de anuncios o piden permisos que no necesitan. Esta aplicación nació para ofrecer una alternativa sencilla a amigos, familiares y conocidos: abrir un documento, leerlo y seguir con lo tuyo.</string>
    <string name="about_what_title">Qué hace</string>
    <string name="about_what_text">Abre tus archivos originales sin duplicarlos, los organiza por categorías, escanea documentos con la cámara, imprime y comparte. Nada más, y nada menos.</string>
    <string name="about_thanks">Gracias por usarla.</string>
    <string name="about_close">Cerrar</string>

    <!-- Privacidad -->
    <string name="about_privacy_title">Privacidad</string>
    <string name="privacy_tagline">Todo ocurre dentro de tu celular.</string>
    <string name="privacy_point_permissions_title">Sin permisos peligrosos</string>
    <string name="privacy_point_permissions_text">La aplicación no pide acceso a tu almacenamiento ni a tu cámara. Cada archivo lo abres tú con el selector del sistema, que concede el acceso uno por uno.</string>
    <string name="privacy_point_network_title">Sin conexión a servidores</string>
    <string name="privacy_point_network_text">Tus documentos no se envían a ninguna parte. No hay cuentas, ni analítica, ni publicidad, ni rastreo.</string>
    <string name="privacy_point_copies_title">Sin copias a tus espaldas</string>
    <string name="privacy_point_copies_text">Se lee el archivo original. La única copia que se hace es la de los documentos que te comparten por WhatsApp o correo, cuyo acceso caduca, y queda guardada en Documentos/Mis PDF.</string>
    <string name="privacy_point_delete_title">Nada se borra solo</string>
    <string name="privacy_point_delete_text">Quitar un documento de la lista nunca borra el archivo. Solo se elimina del celular si lo pides expresamente y lo confirmas.</string>
    <string name="privacy_point_isolated_title">Lectura aislada</string>
    <string name="privacy_point_isolated_text">Los PDF se procesan en un espacio separado del resto de la aplicación, de modo que un archivo dañado no puede afectarla.</string>

