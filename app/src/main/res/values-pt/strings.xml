    <string name="about_title">PDF GioSoft</string>
    <string name="about_tagline">Seus documentos, sem anúncios e sem complicação.</string>
    <string name="about_version">Versão %1$s</string>
    <string name="about_developed_by">Giovanny Tovar</string>
    <string name="about_developer_label">Desenvolvimento</string>
    <string name="about_why_title">Por que ela existe</string>
    <string name="about_why_text">Quase todos os leitores de PDF enchem a tela de anúncios ou pedem permissões de que não precisam. Este aplicativo nasceu para oferecer uma alternativa simples a amigos, familiares e conhecidos: abrir um documento, ler e seguir com a sua vida.</string>
    <string name="about_what_title">O que ela faz</string>
    <string name="about_what_text">Abre seus arquivos originais sem duplicá-los, organiza por categorias, digitaliza documentos com a câmera, imprime e compartilha. Nada mais, nada menos.</string>
    <string name="about_thanks">Obrigado por usar.</string>
    <string name="about_close">Fechar</string>

    <!-- Privacidad -->
    <string name="about_privacy_title">Privacidade</string>
    <string name="privacy_tagline">Tudo acontece dentro do seu celular.</string>
    <string name="privacy_point_permissions_title">Sem permissões perigosas</string>
    <string name="privacy_point_permissions_text">O aplicativo não pede acesso ao seu armazenamento nem à sua câmera. Cada arquivo é você quem abre com o seletor do sistema, que concede o acesso um por um.</string>
    <string name="privacy_point_network_title">Sem conexão com servidores</string>
    <string name="privacy_point_network_text">Seus documentos não são enviados a lugar nenhum. Não há contas, nem análise de uso, nem publicidade, nem rastreamento.</string>
    <string name="privacy_point_copies_title">Sem cópias pelas suas costas</string>
    <string name="privacy_point_copies_text">O arquivo original é o que se lê. A única cópia feita é a dos documentos compartilhados com você por WhatsApp ou e-mail, cujo acesso expira, e fica salva em Documentos/Meus PDF.</string>
    <string name="privacy_point_delete_title">Nada é apagado sozinho</string>
    <string name="privacy_point_delete_text">Retirar um documento da lista nunca apaga o arquivo. Ele só é excluído do celular se você pedir expressamente e confirmar.</string>
    <string name="privacy_point_lock_title">Proteção com digital</string>
    <string name="privacy_point_lock_text">Protege o documento dentro deste aplicativo e neste celular: o arquivo não é criptografado. Se você compartilhar ou abrir com outro aplicativo, ele abrirá sem pedir nada. Para que a proteção viaje junto com o arquivo, coloque uma senha nele.</string>
    <string name="privacy_point_isolated_title">Leitura isolada</string>
    <string name="privacy_point_isolated_text">Os PDF são processados em um espaço separado do resto do aplicativo, de modo que um arquivo danificado não pode afetá-lo.</string>

