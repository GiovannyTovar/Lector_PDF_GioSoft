# PLANTILLA - copia este archivo como "keystore.properties" y rellena los valores.
#
#     cp keystore.properties.template keystore.properties
#
# "keystore.properties" y los .jks estan en .gitignore: NUNCA se suben al repo.
# Si pierdes el .jks o su contrasena, no podras volver a actualizar la app
# publicada en Google Play. Guarda una copia de seguridad fuera del PC.
#
# Para generar el almacen de llaves, ver PUBLICACION.md.

# Ruta al archivo .jks. Relativa a la carpeta app/ o absoluta.
# Ejemplo Windows: C:/Users/GIOVANNY/Documents/Trabajo/Giosoft/llaves/pdfgiosoft/pdfgiosoft-release.jks
storeFile=

# Contrasena del almacen de llaves
storePassword=

# Alias de la llave dentro del almacen
keyAlias=pdfgiosoft

# Contrasena de la llave
keyPassword=
